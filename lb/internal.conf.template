# CloudSentry load balancer: round-robin across two API instances with automatic failover.
#   UPSTREAM_1 / UPSTREAM_2 are host:port pairs, e.g. api1:8000
upstream api_pool {
    server ${UPSTREAM_1} max_fails=1 fail_timeout=5s;
    server ${UPSTREAM_2} max_fails=1 fail_timeout=5s;
}

server {
    listen ${PORT};

    location = /lb-health {
        default_type application/json;
        return 200 '{"status":"healthy","service":"cloudsentry-lb"}';
    }

    location / {
        proxy_pass http://api_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        # If an instance is down (connection error, 502/503/504) retry the request on the other one
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_next_upstream_tries 2;
    }
}
