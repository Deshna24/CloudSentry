# ---- CloudSentry backend configuration (copy to .env, never commit .env) ----
# PostgreSQL connection string. Render/Supabase URLs (postgres:// or postgresql://) both work.
# Leave empty to fall back to a local SQLite file (development only).
DATABASE_URL=postgresql://cloudsentry:change-me@localhost:5432/cloudsentry

# Long random string. REQUIRED in production. All backend instances must share the same value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Identity of this backend instance (shown in dashboard and audit logs)
INSTANCE_ID=API-01
# Instances the dashboard expects to see (comma-separated)
EXPECTED_INSTANCES=API-01,API-02
# OPTIONAL "logical instance" mode: one process registers several instance IDs.
# Leave empty for real multi-instance deployments.
REGISTER_INSTANCES=

ENVIRONMENT=development
AUTO_SEED=true
SEED_RECORDS=2500
# Demo user passwords. If empty, random passwords are generated and printed once in the log.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
# Trust X-Forwarded-For from the load balancer for client IPs
TRUST_PROXY_HEADERS=true
