# ---- Root .env for `docker compose` (copy to .env; never commit .env) ----
# Everything has a safe LOCAL default, so this file is optional locally. Set real values when deploying.

POSTGRES_USER=cloudsentry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudsentry

# Backend (production: DATABASE_URL comes from Render/Supabase instead of the three lines above)
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=

# Frontend (baked into the build). Point it at the load balancer, or the single backend.
VITE_API_URL=http://localhost:8080
